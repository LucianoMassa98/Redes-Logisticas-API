{
  "name": "servicios-tecnologicos-backend",
  "version": "1.0.0",
  "description": "API REST para captación y gestión comercial de leads en servicios tecnológicos",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node src/database/migrate.js up",
    "db:migrate:status": "node src/database/migrate.js status",
    "db:migrate:undo": "node src/database/migrate.js down",
    "db:seed": "node src/database/seed.js",
    "db:admin": "node src/database/createAdmin.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.2",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "keywords": [
    "express",
    "sequelize",
    "postgresql",
    "leads",
    "rest-api",
    "security",
    "cctv",
    "starlink"
