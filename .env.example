# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ==========================================
# BASE DE DATOS (POSTGRESQL)
# ==========================================
# Formato: postgresql://usuario:password@host:puerto/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/redes_seguridad
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ==========================================
# AUTENTICACIÓN JWT Y SESIÓN
# ==========================================
JWT_ACCESS_SECRET=cambiar_este_secreto_por_uno_muy_seguro_en_produccion_access_256
JWT_REFRESH_SECRET=cambiar_este_secreto_por_uno_muy_seguro_en_produccion_refresh_256
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ==========================================
# CÁLCULO DE PRECIOS E INVENTARIO
# ==========================================
# Porcentaje de ganancia sobre el costo para instalaciones (Costo + 100% por defecto)
INSTALLATION_MARKUP_PERCENT=100

# ==========================================
# USUARIO ADMINISTRADOR INICIAL (SEEDER)
# ==========================================
ADMIN_INITIAL_NAME=Administrador Principal
ADMIN_INITIAL_EMAIL=admin@serviciostecnologicos.com
ADMIN_INITIAL_PASSWORD=CambiarPasswordSegura123!

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
